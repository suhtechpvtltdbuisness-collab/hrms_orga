VITE_BACKEND_BASE_URL=http://localhost:4000
# Production (recommended): https://api.orga.cc
# Use a custom domain on the same parent as this frontend, ideally behind
# Cloudflare — avoids the cloud-IP/SNI blocking that breaks some wifi networks.

# Local dev only — shows admin login page. Omit or false in production.
VITE_ENABLE_LOCAL_AUTH=true

VITE_MAIN_SITE_URL=https://suhtech.store
VITE_ADMIN_SITE_URL=https://admin.suhtech.store
